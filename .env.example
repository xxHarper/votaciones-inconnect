# Node.js 24 LTS. Copiar como .env y ejecutar npm run setup.
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/production.sqlite
# Generado por npm run setup; no cambiar después de emitir códigos.
CODE_PEPPER=
# HTTPS directo opcional; ambos archivos PEM locales.
TLS_KEY=
TLS_CERT=
COOKIE_SECURE=false
# Orígenes adicionales EXACTOS, separados por coma. En producción normalmente vacío.
ALLOWED_ORIGINS=
# Solo desarrollo con Vite:
DEV_ORIGIN=http://localhost:5173
VOTER_IDLE_SECONDS=90
VOTER_MAX_SECONDS=600
ADMIN_IDLE_SECONDS=1800
