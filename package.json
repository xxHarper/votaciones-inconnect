{
  "name": "ofrendavote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch scripts/develop.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/manage.js setup",
    "migrate": "node scripts/manage.js migrate",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/manage.js backup",
    "restore": "node scripts/manage.js restore",
    "admin:reset": "node scripts/manage.js admin-reset",
    "test:e2e": "playwright test",
    "format": "prettier --write src server scripts tests vite.config.js playwright.config.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "vite": "^7.2.0"
  }
}
